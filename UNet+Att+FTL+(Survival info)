slice, cmap='gray')\n    axes[2].set_title(\"T1CE\")\n    axes[2].axis('off')\n    \n    axes[3].imshow(t2_slice, cmap='gray')\n    axes[3].set_title(\"T2\")\n    axes[3].axis('off')\n    \n    axes[4].imshow(mask_slice, cmap='gray')\n    axes[4].set_title(\"Mask\")\n    axes[4].axis('off')\n    \n    fig.suptitle(f\"Patient: {patient_id} - Slice: {slice_index}\", fontsize=14)\n    plt.show()\n\n\nsample_patient_id = \"BraTS20_Training_001\"\nshow_modalities_and_mask(sample_patient_id, TRAIN_DATASET_DIR, slice_index=60)","metadata":{"_cell_guid":"9dc810f1-b7c9-47b0-9e19-25337741e1b1","_uuid":"25cda616-372a-4e9d-8aa0-144e81bec83f","execution":{"iopub.status.busy":"2025-03-06T10:54:10.731850Z","iopub.execute_input":"2025-03-06T10:54:10.732052Z","iopub.status.idle":"2025-03-06T10:54:16.554940Z","shell.execute_reply.started":"2025-03-06T10:54:10.732033Z","shell.execute_reply":"2025-03-06T10:54:16.554073Z"},"papermill":{"duration":1.400569,"end_time":"2025-02-03T12:51:36.115403","exception":false,"start_time":"2025-02-03T12:51:34.714834","status":"completed"},"tags":[],"trusted":true},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 2000x500 with 5 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":3},{"id":"07da7f31","cell_type":"code","source":"\nimport matplotlib.colors as mcolors\n\ndef load_images_and_mask(patient_id, dataset_dir):\n    \"\"\"\n    Load the FLAIR image and mask for a given patient.\n    \"\"\"\n    patient_path = os.path.join(dataset_dir, patient_id)\n    flair_image = nib.load(os.path.join(patient_path, f\"{patient_id}_flair.nii\")).get_fdata()\n    mask = nib.load(os.path.join(patient_path, f\"{patient_id}_seg.nii\")).get_fdata()\n    return flair_image, mask\n\ndef map_classes(mask):\n    \"\"\"\n    Map class 4 to class 3 in the mask.\n    \"\"\"\n    mask[mask == 4] = 3\n    return mask\n\ndef plot_flair_with_mask(flair_image, mask, slice_index):\n    \"\"\"\n    Plot the FLAIR image with each class of the mask overlaid.\n    \"\"\"\n    classes = np.unique(mask)\n    classes = classes[classes != 0]  # Exclude background class 0\n    colors = list(mcolors.TABLEAU_COLORS.values())  # Use Tableau colors for distinct colors\n\n    fig, axes = plt.subplots(1, len(classes) + 1, figsize=(20, 5))\n\n    \n    axes[0].imshow(flair_image[:, :, slice_index], cmap='gray')\n    for i, cls in enumerate(classes):\n        masked_image = np.ma.masked_where(mask != cls, mask)\n        axes[0].imshow(masked_image[:, :, slice_index], cmap=mcolors.ListedColormap([colors[i]]), alpha=1)\n    axes[0].set_title(\"All Classes Overlay\")\n    axes[0].axis('off')\n\n    \n    for i, cls in enumerate(classes):\n        masked_image = np.ma.masked_where(mask != cls, mask)\n        axes[i + 1].imshow(flair_image[:, :, slice_index], cmap='gray')\n        axes[i + 1].imshow(masked_image[:, :, slice_index], cmap=mcolors.ListedColormap([colors[i]]), alpha=1)\n        axes[i + 1].set_title(f\"Class {int(cls)} Overlay\")\n        axes[i + 1].axis('off')\n\n    plt.tight_layout()\n    plt.show()\n\n\npatient_id = \"BraTS20_Training_001\"\ndataset_dir = TRAIN_DATASET_DIR\nslice_index = 60\n\n\nflair_image, mask = load_images_and_mask(patient_id, dataset_dir)\n\n\nmask = map_classes(mask)\n\n\nplot_flair_with_mask(flair_image, mask, slice_index)","metadata":{"_cell_guid":"31baa0d1-8262-4c73-9fc0-0bf176f86607","_uuid":"e3c4325c-0df4-49eb-8bd0-92db733d5d4c","collapsed":false,"execution":{"iopub.status.busy":"2025-03-06T10:54:16.556113Z","iopub.execute_input":"2025-03-06T10:54:16.556375Z","iopub.status.idle":"2025-03-06T10:54:18.803919Z","shell.execute_reply.started":"2025-03-06T10:54:16.556351Z","shell.execute_reply":"2025-03-06T10:54:18.803118Z"},"jupyter":{"outputs_hidden":false},"papermill":{"duration":2.211971,"end_time":"2025-02-03T12:51:38.343936","exception":false,"start_time":"2025-02-03T12:51:36.131965","status":"completed"},"tags":[],"trusted":true},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 2000x500 with 4 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":4},{"id":"4b2fa0a9","cell_type":"code","source":"from skimage.util import montage\nfrom scipy.ndimage import rotate\n\n\ndef visualize_coronal_montage(patient_id, dataset_dir, modality=\"flair\", cmap=\"gray\"):\n    \"\"\"\n    Visualizes a montage of coronal slices (top view) for a given patient's 3D modality.\n\n    Args:\n        patient_id (str): Patient ID (e.g., \"BraTS20_Training_001\").\n        dataset_dir (str): Path to the dataset directory.\n        modality (str): Modality to visualize (\"flair\", \"t1\", \"t1ce\", \"t2\").\n        cmap (str): Colormap for the visualization (default is \"gray\").\n    \"\"\"\n    \n    file_path = os.path.join(dataset_dir, patient_id, f\"{patient_id}_{modality}.nii\")\n    \n    \n    if not os.path.exists(file_path):\n        print(f\"File not found: {file_path}\")\n        return\n    volume_3d = nib.load(file_path).get_fdata()\n    \n    \n    coronal_slices = volume_3d.transpose(1, 0, 2)  \n    \n    \n    coronal_montage = montage(coronal_slices)\n    \n    \n    coronal_montage_rotated = rotate(coronal_montage, angle=90)\n    \n    \n    plt.figure(figsize=(20, 20))\n    plt.imshow(coronal_montage_rotated, cmap=cmap)\n    plt.title(f\"{modality.upper()} - Coronal Montage (Top View) for Patient {patient_id}\", fontsize=16)\n    plt.axis('off')\n    plt.show()\n\nsample_patient_id = \"BraTS20_Training_001\"\nvisualize_coronal_montage(sample_patient_id, TRAIN_DATASET_DIR, modality=\"t1\", cmap=\"gray\")","metadata":{"_cell_guid":"54b8158c-4052-4d4f-a8d9-ccaea20976da","_uuid":"222a38a7-3e12-4f89-99a8-d0b7ab19f867","collapsed":false,"execution":{"iopub.status.busy":"2025-03-06T10:54:18.804735Z","iopub.execute_input":"2025-03-06T10:54:18.804952Z","iopub.status.idle":"2025-03-06T10:54:21.940906Z","shell.execute_reply.started":"2025-03-06T10:54:18.804932Z","shell.execute_reply":"2025-03-06T10:54:21.940052Z"},"jupyter":{"o
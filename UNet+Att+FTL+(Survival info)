list=train_files,\n    num_samples=3\n)\n\n# Show some validation slices\nprint(\"Visualizing a few VAL slices:\")\nvisualize_random_slices(\n    images_dir=os.path.join(SAVE_DIR, \"images\"),\n    masks_dir=os.path.join(SAVE_DIR, \"masks\"),\n    file_list=val_files,\n    num_samples=3\n)","metadata":{"_cell_guid":"d923413b-9ec8-4549-a6f7-eebecb7ac730","_uuid":"c9a11ae9-4b14-4863-8e4d-1673ebff302e","collapsed":false,"execution":{"iopub.status.busy":"2025-03-06T11:25:07.122938Z","iopub.execute_input":"2025-03-06T11:25:07.123145Z","iopub.status.idle":"2025-03-06T11:25:08.641937Z","shell.execute_reply.started":"2025-03-06T11:25:07.123123Z","shell.execute_reply":"2025-03-06T11:25:08.641067Z"},"jupyter":{"outputs_hidden":false},"papermill":{"duration":1.663391,"end_time":"2025-02-03T13:05:51.009288","exception":false,"start_time":"2025-02-03T13:05:49.345897","status":"completed"},"tags":[],"trusted":true},"outputs":[{"name":"stdout","text":"Visualizing a few TRAIN slices:\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x400 with 3 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x400 with 3 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x400 with 3 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"Visualizing a few VAL slices:\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x400 with 3 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x400 with 3 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x400 with 3 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":21},{"id":"e11175b4","cell_type":"markdown","source":"#  Compute Class Distribution\n\n##### compute_class_distribution(...)\n\n* Iterates through .npy mask files (in one-hot format).\n* Converts them to label maps, then counts how many pixels belong to each label.\n* Accumulates these counts across all files.\n\n##### Plot Distribution\n\n* Creates a bar chart showing how many pixels are in each class (e.g., background vs. tumor sub-regions).\n* Helpful to confirm the imbalance or any unexpected anomalies.","metadata":{"_cell_guid":"dfc7f623-ce27-460a-85ef-868615e8b9da","_uuid":"cf46a56a-df2a-4246-8446-c7cee236b5c1","collapsed":false,"jupyter":{"outputs_hidden":false},"papermill":{"duration":0.087377,"end_time":"2025-02-03T13:05:51.190100","exception":false,"start_time":"2025-02-03T13:05:51.102723","status":"completed"},"tags":[]}},{"id":"b1086b06","cell_type":"code","source":"def compute_class_distribution(masks_dir, max_files=None):\n    \"\"\"\n    Go through all .npy mask files (one-hot),\n    count how many pixels in each class.\n    \"\"\"\n    all_files = [f for f in os.listdir(masks_dir) if f.endswith('.npy')]\n    if max_files is not None:\n        all_files = all_files[:max_files]\n    \n    total_counts = np.zeros(4, dtype=np.int64)  # for 4 classes\n\n    for fname in all_files:\n        m = np.load(os.path.join(masks_dir, fname))  # shape (H, W, 4)\n        # Convert to label\n        label_2d = np.argmax(m, axis=-1)  # shape (H, W)\n        for c in range(4):\n            total_counts[c] += np.sum(label_2d == c)\n\n    return total_counts\n\n# Compute pixel counts\nmasks_path = \"/kaggle/temp/preprocessed_data/masks\"\ncounts = compute_class_distribution(masks_path)\n\n# Calculate total pixels and ratios\ntotal_pixels = np.sum(counts)\nratios = counts / total_pixels\n\n# Labels\nlabels = ['Background', 'Necrotic/Core', 'Edema', 'Enhancing']\n\n# Visualize as a bar plot with ratios\nplt.figure(figsize=(8, 6))\nbars = plt.bar(labels, counts, color=['blue', 'orange', 'green', 'red'])\n\n# Annotate bars with percentage ratios\nfor bar, ratio in zip(bars, ratios):\n    height = bar.get_height()\n    plt.text(\n        bar.get_x() + bar.get_width() / 2,\n        height + 0.05 * total_pixels,  # Slightly above the bar\n        f\"{ratio * 100:.2f}%\",  # Convert ratio to percentage\n        ha='center',\n        fontsize=10,\n        fontweight='bold'\n    )\n\nplt.title(\"Class Distribution with Ratios (Pixel Counts and Percentages)\", fontsize=14)\nplt.xlabel(\"Classes\", fontsize=12)\nplt.ylabel(\"Pixel Count\", fontsize=12)\nplt.ylim(0, max(counts) * 1.1)  # Add padding to the y-axis for annotations\nplt.grid(axis='y', linestyle='--', alpha=0.7)\nplt.show()\n\n# Print counts and ratios\nfor label, count, ratio in zip(labels, counts, ratios):\n    print(f\"{label}: {count} pixels ({ratio * 100:.2f}%)\")","metadata":{"_cell_guid":"e5e9edad-c178-42f7-9e98-b92850fc314c","_uuid":"67911a67-6e3c-4d8a-be4d-201d4d4135b2","collapsed":false,"execution":{"iopub.status.busy":"2025-03-06T11:25:08.642882Z","iopub.execute_input":"2025-03-06T11:25:08.643144Z","iopub.status.idle":"2025-03-06T11:27:19.273073Z","shell.execute_reply.started":"2025-03-06T11:25:08.643120Z","shell.execute_reply":"2025-03-06T11:27:19.272285Z"},"jupyter":{"outputs_hidden":false},"papermill":{"duration":53.735236,"end_time":"2025-02-03T13:06:45.014842","exception":false,"start_time":"2025-02-03T13:05:51.279606","status":"completed"},"tags":[],"trusted":true},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 800x600 with 1 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"Background: 1391561373 pixels (94.88%)\nNecrotic/Core: 16596426 pixels (1.13%)\nEdema: 43987660 pixels (3.00%)\nEnhancing: 14580941 pixels (0.99%)\n","output_type":"stream"}],"execution_count":22},{"id":"19d61ed8","cell_type":"markdown","source":"# 7) Splitting Train Subsets (Big & Small), Augmentations\n\n##### Separate Train Slices\n\n* train_big and train_small are subsets of train_files, determined by checking membership in all_big_slices or all_small_slices.\n* This helps in building a data generator that can oversample big tumor slices if needed.\n\n##### Augmentation Pipeline (albumentations)\n\n* A set of random transformations used on the 2D slices: flips, rotations, brightness/contrast changes.\n* p=0.5 → each transformation has a 50% chance of being applied.\n* shift_scale_rotate adds random shifting, scaling, and rotation up to ±15°.","metadata":{"_cell_guid":"6d35fcd8-4a49-4648-bbc8-8168731c25f6","_uuid":"1192b8c5-cc16-46af-ab53-eeb9406ca4d7","collapsed":false,"jupyter":{"outputs_hidden":false},"papermill":{"duration":0.085262,"end_time":"2025-02-03T13:06:45.186445","exception":false,"start_time":"2025-02-03T13:06:45.101183","status":"completed"},"tags":[]}},{"id":"5fb0932e","cell_type":"markdown","source":"# 8)Oversampling Data Generator\n\n##### Purpose\n\n* A custom Keras Sequence that loads slices in small batches for training.\n* Allows oversampling “big tumor” slices to avoid class imbalance.\n* Also integrates augmentation.\n##### Key Parameters\n\n* big_slices, small_slices: We store these lists.\n* big_frac: The fraction of each batch that should be “big tumor” slices.\n*  augment=True: If True, apply Albumentations transformations.\n\n###### Methods\n\n* on_epoch_end(): Shuffles the lists at the end of each epoch.\n* __len__(): Defines how many batches per epoch. (Set to 200 here as an arbitrary number of steps.)\n* __getitem__():\n    * Chooses big_count slices from big_slices and small_count from small_slices.\n    * Loads .npy files from disk, optionally applies augmentation.\n    * Returns a batch (X, Y) of size batch_size.","metadata":{"_cell_guid":"73ba8c06-2cf3-44d5-8f09-43e5e2fccc07","_uuid":"8724c737-5391-4745-8ceb-ea5ab4e596f1","collapsed":false,"jupyter":{"outputs_hidden":false},"papermill":{"duration":0.087292,"end_time":"2025-02-03T13:06:45.359863","exception":false,"start_time":"2025-02-03T13:06:45.272571","status":"completed"},"tags":[]}},{"id":"06aff62c","cell_type":"markdown","source":"# 9) Simple Data Generator (Validation)\n* A simpler generator for validation or testing.\n* No oversampling or augmentation.\n* Merely loads data in batches from a given file list.","metadata":{"_cell_guid":"fc4a1964-1e99-4579-a662-976e6e8cdda7","_uuid":"4475f614-cd03-4a34-ba3c-59787a7d748b","collapsed":false,"jupyter":{"outputs_hidden":false},"papermill":{"duration":0.086695,"end_time":"2025-02-03T13:06:45.534294","exception":false,"start_time":"2025-02-03T13:06:45.447599","status":"completed"},"tags":[]}},{"id":"b2e98da1","cell_type":"code","source":"train_big   = [f for f in train_files if f in all_big_slices]\ntrain_small = [f for f in train_files if f in all_small_slices]\n\nprint(\"Train subset breakdown:\")\nprint(f\"  Big slices:   {len(train_big)}\")\nprint(f\"  Small slices: {len(train_small)}\")\n\nimport cv2\n \n# Extended Augmentations\nall_transforms = A.Compose([\n    A.HorizontalFlip(p=1.0),\n    A.VerticalFlip(p=1.0),\n    A.RandomRotate90(p=0.5),\n    A.ShiftScaleRotate(shift_limit=0.05, scale_limit=0.1, rotate_limit=15, p=0.5),\n    A.RandomBrightnessContrast(brightness_limit=0.1, contrast_limit=0.1, p=0.5),\n])\n\n'''all_transforms = A.Compose(\n    [\n        A.Rotate(limit=30, interpolation=cv2.INTER_LINEAR, border_mode=cv2.BORDER_REFLECT, p=1.0),\n        A.HorizontalFlip(p=1.0),\n        A.VerticalFlip(p=1.0),\n        A.RandomBrightnessContrast(brightness_limit=0.2, contrast_limit=0.15, p=1.0),\n        A.ShiftScaleRotate(\n            shift_limit=0.05, scale_limit=0.1, rotate_limit=15,\n            interpolation=cv2.INTER_LINEAR, border_mode=cv2.BORDER_REFLECT, p=1.0\n        ),\n        A.RandomGamma(gamma_limit=(80, 120), p=1.0),\n        A.ElasticTransform(\n            alpha=2, sigma=50,\n            interpolation=cv2.INTER_LINEAR,\n            mask_interpolation=cv2.INTER_NEAREST,\n            border_mode=cv2.BORDER_REFLECT,\n            p=1.0\n        ),\n        A.GaussNoise(var_limit=(5.0, 20.0), p=1.0),\n        A.GridDistortion(num_steps=5, distort_limit=0.3, p=1.0),\n        A.CLAHE(clip_limit=2.0, tile_grid_size=(8,8), p=1.0)\n    ],\n    additional_targets={\n        \"image1\": \"image\",\n        \"image2\": \"image\",\n        \"image3\": \"image\",\n    }\n)\n'''\n\nclass OversampleAllAugGenerator(Sequence):\n    \"\"\"\n    1) Oversamples big tumor slices vs. small tumor slices.\n    2) Applies all transformations in 'all_transforms' pipeline to each slice.\n    \"\"\"\n\n    def __init__(\n        self,\n        big_slices, small_slices,\n        images_dir, masks_dir,\n        batch_size=8,\n        big_frac=0.6,\n        shuffle=True,\n        augment=True\n    ):\n        self.big_slices   = big_slices\n        self.small_slices = small_slices\n        self.images_dir   = images_dir\n        self.masks_dir    = masks_dir\n        self.batch_size   = batch_size\n        self.big_count    = int(self.batch_size * big_frac)\n        self.small_count  = self.batch_size - self.big_count\n        self.shuffle      = shuffle\n        self.augment      = augment\n        self.on_epoch_end()\n\n    def on_epoch_end(self):\n        # Shuffle big_slices, small_slices if needed\n        if self.shuffle:\n            random.shuffle(self.big_slices)\n            random.shuffle(self.small_slices)\n\n    def __len__(self):\n        total_slices = len(self.big_slices) + len(self.small_slices)\n        return (total_slices + self.batch_size - 1) // self.batch_size\n\n    def __getitem__(self, idx):\n        chosen_big   = np.random.choice(self.big_slices,   size=self.big_count,   replace=True)\n        chosen_small = np.random.choice(self.small_slices, size=self.small_count, replace=True)\n        batch_files  = list(chosen_big) + list(chosen_small)\n        random.shuffle(batch_files)\n\n        X, Y = [], []\n        for fname in batch_files:\n            img_path  = os.path.join(self.images_dir, fname)\n            mask_path = os.path.join(self.masks_dir,  fname)\n\n            img_4ch  = np.load(img_path)\n            mask_1hot= np.load(mask_path)\n            label_2d = np.argmax(mask_1hot, axis=-1).astype(np.uint8)\n\n            if self.augment:\n                # Using additional_targets in Albumentations\n                transform = A.Compose([\n                    A.Flip(p=0.5),\n                    A.RandomRotate90(p=0.5),\n                    A.ShiftScaleRotate(shift_limit=0.05, scale_limit=0.1, rotate_limit=15, p=0.5),\n                    A.RandomBrightnessContrast(brightness_limit=0.1, contrast_limit=0.1, p=0.5),\n                ], additional_targets={\n                    \"image2\": \"image\",\n                    \"image3\": \"image\",\n                    \"image4\": \"image\",\n                })\n                aug_in = {\n                    \"image\":  img_4ch[...,0],\n                    \"image2\": img_4ch[...,1],\n                    \"image3\": img_4ch[...,2],\n                    \"image4\": img_4ch[...,3],\n                    \"mask\":   label_2d\n                }\n                augmented = transform(**aug_in)\n                c0 = augmented[\"image\"]\n                c1 = augmented[\"image2\"]\n                c2 = augmented[\"image3\"]\n                c3 = augmented[\"image4\"]\n                aug_mask_2d = augmented[\"mask\"]\n\n                aug_img_4ch = np.stack([c0,c1,c2,c3], axis=-1)\n                H_,W_ = aug_mask_2d.shape\n                aug_mask_1hot = np.eye(N_CLASSES)[aug_mask_2d.reshape(-1)].reshape(H_,W_,N_CLASSES)\n\n                X.append(aug_img_4ch)\n                Y.append(aug_mask_1hot)\n            else:\n                X.append(img_4ch)\n                Y.append(mask_1hot)\n\n        return np.array(X, dtype=np.float32), np.array(Y, dtype=np.float32)\n\n\nclass SimpleDataGenerator(Sequence):\n    def __init__(self, file_list, images_dir, masks_dir, batch_size=8):\n        self.file_list  = file_list\n        self.images_dir = images_dir\n        self.masks_dir  = masks_dir\n        self.batch_size = batch_size\n\n    def __len__(self):\n        \n        return (len(self.file_list) + self.batch_size - 1) // self.batch_size\n\n\n    def __getitem__(self, idx):\n        batch_f = self.file_list[idx*self.batch_size : (idx+1)*self.batch_size]\n        X, Y = [], []\n        for fname in batch_f:\n            img_4ch  = np.load(os.path.join(self.images_dir, fname))\n            mask_1hot= np.load(os.path.join(self.masks_dir, fname))\n            X.append(img_4ch)\n            Y.append(mask_1hot)\n        return np.array(X, dtype=np.float32), np.array(Y, dtype=np.float32)","metadata":{"_cell_guid":"91f42be3-0571-4366-8930-3bf5ab89ad6d","_uuid":"3e1b6d47-3ef6-42bc-a9d7-f447e9d02f52","collapsed":false,"execution":{"iopub.status.busy":"2025-03-06T11:27:19.276823Z","iopub.execute_input":"2025-03-06T11:27:19.277051Z","iopub.status.idle":"2025-03-06T11:27:25.201778Z","shell.execute_reply.started":"2025-03-06T11:27:19.277031Z","shell.execute_reply":"2025-03-06T11:27:25.200928Z"},"jupyter":{"outputs_hidden":false},"papermill":{"duration":5.781897,"end_time":"2025-02-03T13:06:51.402757","exception":false,"start_time":"2025-02-03T13:06:45.620860","status":"completed"},"tags":[],"trusted":true},"outputs":[{"name":"stdout","text":"Train subset breakdown:\n  Big slices:   13773\n  Small slices: 6784\n","output_type":"stream"}],"execution_count":23},{"id":"c647816f","cell_type":"markdown","source":"# 10) Visualize Augmented Samples\n\n* Loads the first batch from generator[0].\n* Displays some images to confirm that augmentations (flips, rotations, etc.) are indeed applied.\n* We see the Flair channel, T1 channel, and the color-coded mask (argmax over the one-hot).","metadata":{"_cell_guid":"0e3e19f6-27fa-499f-93e3-9a417076f900","_uuid":"056e2fa2-997b-46ed-9a69-aece66a5ca56","collapsed":false,"jupyter":{"outputs_hidden":false},"papermill":{"duration":0.086411,"end_time":"2025-02-03T13:06:51.578072","exception":false,"start_time":"2025-02-03T13:06:51.491661","status":"completed"},"tags":[]}},{"id":"3ab047f0","cell_type":"code","source":"\naugmentations_list = A.Compose([\n    A.HorizontalFlip(p=1.0),\n    A.VerticalFlip(p=1.0),\n    A.RandomRotate90(p=0.5),\n    A.ShiftScaleRotate(shift_limit=0.05, scale_limit=0.1, rotate_limit=15, p=0.5),\n    A.RandomBrightnessContrast(brightness_limit=0.1, contrast_limit=0.1, p=0.5),\n])\n\n\n\ndef visualize_augmentations(images_dir, masks_dir, file_list, num_samples=2):\n    \"\"\"\n    For 'num_samples' random slices from file_list:\n      - Load the original image (4-channel) & mask\n      - For each augmentation, apply it individually\n      - Display the original + augmented versions with titles for each augmentation\n    \"\"\"\n    sample_files = random.sample(file_list, k=min(num_samples, len(file_list)))\n\n    for f in sample_files:\n        # Load original .npy\n        img_path = os.path.join(images_dir, f)\n        mask_path = os.path.join(masks_dir, f)\n        img_4ch = np.load(img_path)  # shape (H, W, 4)\n        mask_1hot = np.load(mask_path)  # shape (H, W, 4)\n\n        # Convert mask to label for augmentation\n        mask_label = np.argmax(mask_1hot, axis=-1).astype(np.uint8)\n\n        # We'll store images in a list: [original, aug1, aug2, ...]\n        augmented_images = [img_4ch]\n        augmented_labels = [mask_label]\n\n        # For each augmentation, apply it\n        for aug in augmentations_list:\n            transform = A.Compose(\n                [aug],\n                additional_targets={\n                    \"image1\": \"image\",\n                    \"image2\": \"image\",\n                    \"image3\": \"image\"\n                }\n            )\n            aug_in = {\n                \"image\": img_4ch[..., 0],\n                \"image1\": img_4ch[..., 1],\n                \"image2\": img_4ch[..., 2],\n                \"image3\": img_4ch[..., 3],\n                \"mask\": mask_label\n            }\n            output = transform(**aug_in)\n\n            # Reassemble augmented image\n            c0 = output[\"image\"]\n            c1 = output[\"image1\"]\n            c2 = output[\"image2\"]\n            c3 = output[\"image3\"]\n            out_img_4ch = np.stack([c0, c1, c2, c3], axis=-1)\n            out_mask_lbl = output[\"mask\"]\n\n            augmented_images.append(out_img_4ch)\n            augmented_labels.append(out_mask_lbl)\n\n        # Display original + augmented images and masks\n        num_augmentations = len(augmentations_list) + 1\n        plt.figure(figsize=(24, 10))  # Larger figure size for better visibility\n\n        # Flair channel visualizations\n        for i in range(num_augmentations):\n            plt.subplot(2, num_augmentations, i + 1)\n            plt.imshow(augmented_images[i][..., 0], cmap=\"gray\")\n            if i == 0:\n                plt.title(\"Original Flair\", fontsize=14)\n            else:\n                plt.title(augmentations_list[i - 1].__class__.__name__, fontsize=14)\n            plt.axis(\"off\")\n\n        \n\n# Run the visualization with updated augmentations\nvisualize_augmentations(\n    images_dir=os.path.join(SAVE_DIR, \"images\"),\n    masks_dir=os.path.join(SAVE_DIR, \"masks\"),\n    file_list=train_files,  # or val_files\n    num_samples=3\n)","metadata":{"_cell_guid":"36ecf340-98d4-43cc-87bc-ac581c5ae831","_uuid":"ee72429c-567f-4f98-8f27-2e8fcb076bfc","collapsed":false,"execution":{"iopub.status.busy":"2025-03-06T11:27:25.203890Z","iopub.execute_input":"2025-03-06T11:27:25.204215Z","iopub.status.idle":"2025-03-06T11:27:27.059726Z","shell.execute_reply.started":"2025-03-06T11:27:25.204183Z","shell.execute_reply":"2025-03-06T11:27:27.058742Z"},"jupyter":{"outputs_hidden":false},"papermill":{"duration":1.895528,"end_time":"2025-02-03T13:06:53.563060","exception":false,"start_time":"2025-02-03T13:06:51.667532","status":"completed"},"tags":[],"trusted":true},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 2400x1000 with 6 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 2400x1000 with 6 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 2400x1000 with 6 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":24},{"id":"d95bea56","cell_type":"markdown","source":"# 11) Instantiate Generators\n\n##### train_gen\n\n* Uses OversampleAugGenerator to fetch training batches.\n* big_frac=0.5 means half the batch from big tumor slices, half from smaller/no tumor slices.\n  \n##### val_gen\n\n* Uses SimpleDataGenerator for validation without data augmentation or special sampling.\n\n##### Print Steps\n* Just for reference: how many batches per epoch for training (train_gen) and validation (val_gen).","metadata":{"_cell_guid":"a9388e17-a6a0-4574-861a-26ceb5edfe36","_uuid":"8d5ab9df-5799-451c-9e19-c9876024634f","collapsed":false,"jupyter":{"outputs_hidden":false},"papermill":{"duration":0.138193,"end_time":"2025-02-03T13:06:53.828870","exception":false,"start_time":"2025-02-03T13:06:53.690677","status":"completed"},"tags":[]}},{"id":"f381e5f6","cell_type":"code","source":"train_gen = OversampleAllAugGenerator(\n    big_slices=train_big,\n    small_slices=train_small,\n    images_dir=os.path.join(SAVE_DIR, \"images\"),\n    masks_dir=os.path.join(SAVE_DIR, \"masks\"),\n    batch_size=BATCH_SIZE,\n    big_frac=0.5,\n    shuffle=True,\n    augment=True\n)\nval_gen = SimpleDataGenerator(\n    val_files,\n    images_dir=os.path.join(SAVE_DIR, \"images\"),\n    masks_dir=os.path.join(SAVE_DIR, \"masks\"),\n    batch_size=BATCH_SIZE\n)","metadata":{"_cell_guid":"818526ba-b2f9-47cb-ad5f-e9be0e7f0593","_uuid":"e73fcf47-89a6-4b36-9d15-52b1612ee6f5","collapsed":false,"execution":{"iopub.status.busy":"2025-03-06T11:27:27.060567Z","iopub.execute_input":"2025-03-06T11:27:27.060969Z","iopub.status.idle":"2025-03-06T11:27:27.076548Z","shell.execute_reply.started":"2025-03-06T11:27:27.060927Z","shell.execute_reply":"2025-03-06T11:27:27.075809Z"},"jupyter":{"outputs_hidden":false},"papermill":{"duration":0.129058,"end_time":"2025-02-03T13:06:54.066470","exception":false,"start_time":"2025-02-03T13:06:53.937412","status":"completed"},"tags":[],"trusted":true},"outputs":[],"execution_count":25},{"id":"ade838c6","cell_type":"code","source":"\nstrategy = tf.distribute.MirroredStrategy()\nprint(\"Number of devices: \", strategy.num_replicas_in_sync)","metadata":{"_cell_guid":"8d1e3de3-0446-4edb-be34-1cc38139def8","_uuid":"97fc14f8-14d3-4915-8f22-192afff7ecbf","collapsed":false,"execution":{"iopub.status.busy":"2025-03-06T11:27:27.077279Z","iopub.execute_input":"2025-03-06T11:27:27.077582Z","iopub.status.idle":"2025-03-06T11:27:28.225229Z","shell.execute_reply.started":"2025-03-06T11:27:27.077547Z","shell.execute_reply":"2025-03-06T11:27:28.224380Z"},"jupyter":{"outputs_hidden":false},"papermill":{"duration":1.174599,"end_time":"2025-02-03T13:06:55.346332","exception":false,"start_time":"2025-02-03T13:06:54.171733","status":"completed"},"tags":[],"trusted":true},"outputs":[{"name":"stdout","text":"Number of devices:  2\n","output_type":"stream"}],"execution_count":26},{"id":"fec89937","cell_type":"markdown","source":"# 13) Define U-Net Model and Loss Functions\n\n##### unet_conv_block(...)\n\n* A small helper: 2× Conv2D (3×3), each followed by BatchNormalization, ReLU activation.\n* Basic building block of the U-Net.\n\n##### build_unet(...)\n\n* Constructs the U-Net encoder-decoder:\n    * Downsampling: repeated unet_conv_block, then MaxPool.\n    * Bottleneck: a deeper layer with higher filters.\n    * Upsampling: UpSampling2D + concatenation of encoder features + unet_conv_block.\n* Final output: 1×1 conv to produce num_classes channels with softmax.","metadata":{"_cell_guid":"509d1b8f-89a3-4838-965b-6ef9bfb9d9c7","_uuid":"0108c0f8-915a-4d43-85cd-b01f15240741","collapsed":false,"jupyter":{"outputs_hidden":false},"papermill":{"duration":0.107261,"end_time":"2025-02-03T13:06:55.560904","exception":false,"start_time":"2025-02-03T13:06:55.453643","status":"completed"},"tags":[]}},{"id":"ffe0d9c2","cell_type":"code","source":" \n\ndef attention_gate(x, g, filters):\n    theta_x = layers.Conv2D(filters, 1, padding='same')(x)\n    phi_g = layers.Conv2D(filters, 1, padding='same')(g)\n    \n    add = layers.Add()([theta_x, phi_g])\n    act = layers.ReLU()(add)\n    \n    psi = layers.Conv2D(1, 1, padding='same', activation='sigmoid')(act)\n    \n    return layers.Multiply()([x, psi])\n\ndef unet_conv_block(x, filters):\n    x = layers.Conv2D(filters, 3, padding='same')(x)\n    x = layers.BatchNormalization()(x)\n    x = layers.ReLU()(x)\n    \n    x = layers.Conv2D(filters, 3, padding='same')(x)\n    x = layers.BatchNormalization()(x)\n    x = layers.ReLU()(x)\n    \n   \n    return x\n\ndef build_unet(input_shape=(240, 240, 4), num_classes=4):\n    inputs = layers.Input(shape=input_shape)\n    \n    c1 = unet_conv_block(inputs, 64)\n    p1 = layers.MaxPooling2D()(c1)\n    \n    c2 = unet_conv_block(p1, 128)\n    p2 = layers.MaxPooling2D()(c2)\n    \n    c3 = unet_conv_block(p2, 256)\n    p3 = layers.MaxPooling2D()(c3)\n    \n    c4 = unet_conv_block(p3, 512)\n    p4 = layers.MaxPooling2D()(c4)\n    \n    c5 = unet_conv_block(p4, 512)\n    \n    u1 = layers.UpSampling2D()(c5)\n    c4 = attention_gate(c4, u1, 512)\n    u1 = layers.concatenate([u1, c4], axis=-1)\n    c6 = unet_conv_block(u1, 512)\n    \n    u2 = layers.UpSampling2D()(c6)\n    c3 = attention_gate(c3, u2, 256)\n    u2 = layers.concatenate([u2, c3], axis=-1)\n    c7 = unet_conv_block(u2, 256)\n    \n    u3 = layers.UpSampling2D()(c7)\n    c2 = attention_gate(c2, u3, 128)\n    u3 = layers.concatenate([u3, c2], axis=-1)\n    c8 = unet_conv_block(u3, 128)\n    \n    u4 = layers.UpSampling2D()(c8)\n    c1 = attention_gate(c1, u4, 64)\n    u4 = layers.concatenate([u4, c1], axis=-1)\n    c9 = unet_conv_block(u4, 64)\n    \n    outputs = layers.Conv2D(num_classes, 1, activation='softmax')(c9)\n    \n    return Model(inputs, outputs)\n\n","metadata":{"_cell_guid":"196c0ac3-109f-4ad1-8486-550b7dfa919b","_uuid":"927c0828-a7e1-4269-96f2-00a3f0d66e9d","collapsed":false,"execution":{"iopub.status.busy":"2025-03-06T11:27:28.226004Z","iopub.execute_input":"2025-03-06T11:27:28.226206Z","iopub.status.idle":"2025-03-06T11:27:28.234917Z","shell.execute_reply.started":"2025-03-06T11:27:28.226188Z","shell.execute_reply":"2025-03-06T11:27:28.234203Z"},"jupyter":{"outputs_hidden":false},"papermill":{"duration":0.117459,"end_time":"2025-02-03T13:06:55.783176","exception":false,"start_time":"2025-02-03T13:06:55.665717","status":"completed"},"tags":[],"trusted":true},"outputs":[],"execution_count":27},{"id":"56ccbcc8","cell_type":"markdown","source":"# Metrics\n\n## Loss Functions\n\n* dice_loss:1−Dice measure for segmentation overlap.\n* focal_loss: Weighted cross-entropy that focuses on hard examples.\n* combined_loss: Weighted sum of Dice and Focal (0.5 each).\n\n## PerClassDiceCallback\n\n* Custom callback to compute per-class Dice after each epoch for logging/monitoring.\n* Gathers predictions on a portion of the validation set, sums intersection and union,\n* calculates Dice for each class.","metadata":{"_cell_guid":"9af01198-94f4-49b2-b1d3-545c96402bde","_uuid":"68369b9e-fd39-418a-a8a0-8a9ec21dce48","collapsed":false,"jupyter":{"outputs_hidden":false},"papermill":{"duration":0.105958,"end_time":"2025-02-03T13:06:55.993465","exception":false,"start_time":"2025-02-03T13:06:55.887507","status":"completed"},"tags":[]}},{"id":"91d04451","cell_type":"code","source":"@tf.function\ndef dice_coefficient(y_true, y_pred, smooth=1e-6):\n    \"\"\"\n    Computes the mean Dice Coefficient over all classes.\n    Expects y_true and y_pred in [Batch, Height, Width, Classes] format (one-hot).\n    \"\"\"\n    # Clip predictions to avoid log(0) in some edge cases\n    y_pred = tf.clip_by_value(y_pred, smooth, 1.0 - smooth)\n    \n    # Calculate per-class dice\n    intersection = tf.reduce_sum(y_true * y_pred, axis=[0,1,2])  # sum across batch+spatial dims\n    union        = tf.reduce_sum(y_true + y_pred, axis=[0,1,2])\n    dice_per_class = (2. * intersection + smooth) / (union + smooth)\n\n    # Average across classes\n    return tf.reduce_mean(dice_per_class)\n\n\n\n@tf.function\ndef tversky_index(y_true, y_pred, alpha=0.9, beta=0.1, smooth=1e-6):\n    \"\"\"\n    Tversky index for multi-class one-hot or binary masks.\n    alpha,beta: controls weighting of FP vs FN.\n    y_true, y_pred: shape (batch, H, W, classes)\n    \"\"\"\n    # Flatten\n    y_true_f = tf.reshape(y_true, [-1])\n    y_pred_f = tf.reshape(y_pred, [-1])\n\n    # Tversky\n    tp = tf.reduce_sum(y_true_f * y_pred_f)\n    fp = tf.reduce_sum((1 - y_true_f) * y_pred_f)\n    fn = tf.reduce_sum(y_true_f * (1 - y_pred_f))\n\n    return (tp + smooth) / (tp + alpha*fp + beta*fn + smooth)\n\n\n@tf.function\ndef focal_tversky_loss(y_true, y_pred, alpha=0.9, beta=0.1, gamma=4/3, smooth=1e-6):\n    \"\"\"\n    Focal Tversky Loss = (1 - Tversky)**gamma\n    alpha,beta: Tversky weighting. gamma>1 => strong focus on misclassified regions.\n    \"\"\"\n    ti = tversky_index(y_true, y_pred, alpha=alpha, beta=beta, smooth=smooth)\n    return tf.pow((1 - ti), gamma)\n\n# Callback for Per-Class Dice\nclass PerClassDiceCallback(tf.keras.callbacks.Callback):\n    def __init__(self, generator, steps=5, label=\"val\"):\n        super().__init__()\n        self.gen = generator\n        self.steps = steps\n        self.label = label\n\n    def on_epoch_end(self, epoch, logs=None):\n        import numpy as np\n        total_intersection = np.zeros(N_CLASSES, dtype=np.float64)\n        total_union        = np.zeros(N_CLASSES, dtype=np.float64)\n\n        for i in range(self.steps):\n            Xb, Yb = next(iter(self.gen))\n            Pb = self.model.predict(Xb, verbose=0)\n            for b in range(len(Xb)):\n                y_true = Yb[b]  # shape (H,W,4)\n                y_pred = Pb[b]  # shape (H,W,4)\n                intersection = np.sum(y_true*y_pred, axis=(0,1))\n                union        = np.sum(y_true+y_pred, axis=(0,1))\n                total_intersection += intersection\n                total_union        += union\n\n        dice_per_class = (2.*total_intersection + 1e-6)/(total_union + 1e-6)\n        msg = [f\"Class {c}={dice_per_class[c]:.4f}\" for c in range(N_CLASSES)]\n        print(f\"\\nEpoch {epoch+1} {self.label}-Dice:\", \", \".join(msg))\n\n        for c in range(N_CLASSES):\n            logs[f\"{self.label}_dice_class{c}\"] = dice_per_class[c]","metadata":{"_cell_guid":"43827f29-0208-4654-af6e-df74c58f89db","_uuid":"e7fd4de0-4b73-4999-af41-5f7ad88aa942","collapsed":false,"execution":{"iopub.status.busy":"2025-03-06T11:27:28.235729Z","iopub.execute_input":"2025-03-06T11:27:28.236006Z","iopub.status.idle":"2025-03-06T11:27:28.252107Z","shell.execute_reply.started":"2025-03-06T11:27:28.235977Z","shell.execute_reply":"2025-03-06T11:27:28.251507Z"},"jupyter":{"outputs_hidden":false},"papermill":{"duration":0.123311,"end_time":"2025-02-03T13:06:56.224819","exception":false,"start_time":"2025-02-03T13:06:56.101508","status":"completed"},"tags":[],"trusted":true},"outputs":[],"execution_count":28},{"id":"3de2645e","cell_type":"markdown","source":"# 15) Build, Compile, and Train the Model\n\n##### Model Instantiation\n\n* build_unet(...) → returns a Keras Model.\n##### model.compile(...)\n\n* Optimizer: Adam with an initial learning rate of 1𝑒−4.\n* Loss: combined_loss (Dice + Focal).\n* Metrics: Accuracy and MeanIoU.\n##### Callbacks\n\n* ModelCheckpoint: Saves the model weights each time the validation loss improves.\n* ReduceLROnPlateau: If val_loss plateaus, reduce learning rate by a factor of 0.5.\n* PerClassDiceCallback: Logs per-class Dice scores at the end of each epoch.\n##### Training\n\n* model.fit(...) with train_gen as the training generator and val_gen as the validation generator.\n* 50 epochs total.","metadata":{"_cell_guid":"06440b20-fba9-4753-8355-8399f63e8ca5","_uuid":"5f75d6cb-3b30-4308-b3c4-8bfd2d74d328","collapsed":false,"jupyter":{"outputs_hidden":false},"papermill":{"duration":0.104756,"end_time":"2025-02-03T13:06:56.433658","exception":false,"start_time":"2025-02-03T13:06:56.328902","status":"completed"},"tags":[]}},{"id":"168bdc5a","cell_type":"code","source":"with strategy.scope():\n    model = build_unet(input_shape=(IMG_HEIGHT, IMG_WIDTH, N_CHANNELS))\n    model.compile(\n        optimizer=Adam(1e-4),\n        loss=focal_tversky_loss,\n        metrics=[\n            \"accuracy\",\n            dice_coefficient,\n        ]\n    )\n    \n    checkpoint_cb = ModelCheckpoint(\n        \"/kaggle/working/best_unet_model.keras\",\n        monitor=\"val_loss\",\n        save_best_only=True,\n        verbose=1\n    )\n    reduce_lr_cb = ReduceLROnPlateau(\n        monitor=\"val_loss\",\n        factor=0.5,\n        patience=5,\n        min_lr=1e-6,\n        verbose=1\n    )\n    dice_cb = PerClassDiceCallback(val_gen, steps=5, label=\"val\")\n    EPOCHS=50\n    history = model.fit(\n        train_gen,\n        validation_data=val_gen,\n        epochs=EPOCHS,\n        callbacks=[checkpoint_cb, reduce_lr_cb, dice_cb]\n    )","metadata":{"_cell_guid":"f0aee416-66e4-4f41-9375-7a34474b4829","_uuid":"df4d96f5-c18d-499b-8d14-8000d101227f","collapsed":false,"execution":{"iopub.status.busy":"2025-03-06T11:27:28.252951Z","iopub.execute_input":"2025-03-06T11:27:28.253226Z","iopub.status.idle":"2025-03-06T15:10:02.698137Z","shell.execute_reply.started":"2025-03-06T11:27:28.253198Z","shell.execute_reply":"2025-03-06T15:10:02.695731Z"},"jupyter":{"outputs_hidden":false},"papermill":{"duration":4150.695442,"end_time":"2025-02-03T14:16:07.233669","exception":false,"start_time":"2025-02-03T13:06:56.538227","status":"completed"},"tags":[],"trusted":true},"outputs":[{"name":"stderr","text":"<ipython-input-23-7362981beaf3>:104: DeprecationWarning: Flip is deprecated. Consider using HorizontalFlip, VerticalFlip, RandomRotate90 or D4.\n  A.Flip(p=
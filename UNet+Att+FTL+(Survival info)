"\"\n    coverage_counts = np.zeros(n_classes, dtype=np.int64)\n    \n    for i, pid in enumerate(patient_ids, start=1):\n        seg_path = os.path.join(dataset_dir, pid, f\"{pid}_seg.nii\")\n        if not os.path.exists(seg_path):\n            continue\n        \n        seg_data = nib.load(seg_path).get_fdata()\n        seg_data[seg_data == 4] = 3\n        \n        \n        depth = seg_data.shape[-1]\n        for z in range(depth):\n            slice_2d = seg_data[..., z]\n            \n            unique_vals = np.unique(slice_2d)\n            for c in unique_vals:\n                if c < n_classes:  \n                    coverage_counts[int(c)] += 1\n        \n    \n    return coverage_counts\n\nslice_coverage = compute_slice_class_coverage(TRAIN_DATASET_DIR, all_patient_ids, n_classes=4)\n\nprint(\"Total Slices are: \",(368*155))\n\n\n\nlabels = ['Background', 'Necrotic/Core', 'Edema', 'Enhancing']\n\n\n\nplt.figure(figsize=(8, 6))\nbars = plt.bar(labels, slice_coverage, color=['black', 'red', 'blue', 'green'])\n\n\nplt.title(\"How Many Slices Contain Each Class\")\nplt.ylabel(\"Count of Slices\")\n\n\nplt.grid(axis='y', linestyle='--', alpha=0.7)\n\n\nfor bar in bars:\n    height = bar.get_height()\n    plt.text(bar.get_x() + bar.get_width() / 2, height, f'{int(height)}', \n             ha='center', va='bottom', fontsize=12, color='black')\n\n\nplt.show()","metadata":{"_cell_guid":"12b9ef3f-5c36-4604-8d17-4d71a0a5b7d0","_uuid":"d1d90c8e-2566-470e-adc1-64dcd3a09b34","execution":{"iopub.status.busy":"2025-03-06T10:57:39.083953Z","iopub.execute_input":"2025-03-06T10:57:39.084270Z","iopub.status.idle":"2025-03-06T10:58:48.001381Z","shell.execute_reply.started":"2025-03-06T10:57:39.084239Z","shell.execute_reply":"2025-03-06T10:58:48.000536Z"},"papermill":{"duration":69.403786,"end_time":"2025-02-03T12:53:49.485708","exception":false,"start_time":"2025-02-03T12:52:40.081922","status":"completed"},"tags":[],"trusted":true},"outputs":[{"name":"stdout","text":"Total Slices are:  57040\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 800x600 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":10},{"id":"1b1a64eb","cell_type":"code","source":"def compute_class_distribution_3d(dataset_dir, patient_ids, n_classes=4):\n    \n    total_counts = np.zeros(n_classes, dtype=np.int64)\n    \n    for i, pid in enumerate(patient_ids, start=1):\n        seg_path = os.path.join(dataset_dir, pid, f\"{pid}_seg.nii\")\n        if not os.path.exists(seg_path):\n            \n            continue\n        \n        seg_data = nib.load(seg_path).get_fdata()\n        seg_data[seg_data == 4] = 3  \n\n        \n        for c in range(n_classes):\n            total_counts[c] += np.count_nonzero(seg_data == c)\n    \n    return total_counts\n\n\nlabels = ['Background', 'Necrotic/Core', 'Edema', 'Enhancing']\nall_patients = [d for d in os.listdir(TRAIN_DATASET_DIR)\n                if d.startswith(\"BraTS20_Training_\") \n                and os.path.isdir(os.path.join(TRAIN_DATASET_DIR, d))]\n\nclass_counts = compute_class_distribution_3d(TRAIN_DATASET_DIR, all_patients, n_classes=4)\n\nprint(\"Overall pixel distribution ('Background','Necrotic/Core','Edema','Enhancing'):\\n\", class_counts)\n\n\nimport matplotlib.pyplot as plt\n\n\ntotal_pixels = np.sum(class_counts)  \nratios = class_counts / total_pixels  \n\n\nplt.figure(figsize=(8, 6))\nbars = plt.bar(labels, class_counts )\n\n\nfor bar, ratio in zip(bars, ratios):\n    height = bar.get_height()\n    plt.text(\n        bar.get_x() + bar.get_width() / 2,\n        height + 0.05 * total_pixels,\n        f\"{ratio * 100:.2f}%\",  \n        ha='center',\n        fontsize=10,\n        fontweight='bold'\n    )\nplt.title(\"Dataset-wide Class Distribution (Pixel Counts and Ratios)\", fontsize=14)\nplt.ylabel(\"Pixel Count\", fontsize=12)\nplt.xlabel(\"Classes\", fontsize=12)\nplt.ylim(0, max(class_counts) * 1.1) \n\nplt.show()","metadata":{"_cell_guid":"823774c2-316e-4565-a2a8-fa2284b685d5","_uuid":"14c86173-7082-4ac8-93c7-b6a33150505a","execution":{"iopub.status.busy":"2025-03-06T10:58:48.002429Z","iopub.execute_input":"2025-03-06T10:58:48.002685Z","iopub.status.idle":"2025-03-06T10:59:30.089792Z","shell.execute_reply.started":"2025-03-06T10:58:48.002662Z","shell.execute_reply":"2025-03-06T10:59:30.089018Z"},"papermill":{"duration":39.655928,"end_time":"2025-02-03T12:54:29.181674","exception":false,"start_time":"2025-02-03T12:53:49.525746","status":"completed"},"tags":[],"trusted":true},"outputs":[{"name":"stdout","text":"Overall pixel distribution ('Background','Necrotic/Core','Edema','Enhancing'):\n [3248909300    8129761   21256835    7208104]\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 800x600 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":11},{"id":"68dba474","cell_type":"markdown","source":"# 3) Z-Score Normalization & Cropping\n\n##### z_score_normalize(slice_2d, epsilon=1e-8)\n\n* Computes the mean and standard deviation of a 2D slice.\n* Returns the slice with each pixel standardized as 𝑥−𝜇/𝜎+𝜖\n* epsilon avoids division by zero.\n##### crop_to_brain_with_mask(...)\n\n\n* Takes four MRI channels (Flair, T1, T1CE, T2) and the segmentation mask for a single 2D slice.\n* Finds the bounding box of the brain region by checking non-zero intensities.\n    * coords = np.where(combined > 1e-5) gets the region of interest.\n* Applies a small margin around that bounding box to ensure some context.\n* If the slice is completely zero (rare), it falls back to just resizing the slice without cropping.\n* Z-score normalizes each channel and then resizes each channel to out_size (240×240).\n* Mask is also resized (using order=0 for nearest-neighbor) to maintain the discrete labels.\n* Returns (final_img, final_mask):\n    * final_img.shape = (240, 240, 4)\n    * final_mask.shape = (240, 240)","metadata":{"_cell_guid":"2549c780-fef7-4293-87c6-ddf3e84a82ff","_uuid":"44aa1e92-4aba-49c8-9347-38f96543438e","collapsed":false,"jupyter":{"outputs_hidden":false},"papermill":{"duration":0.037078,"end_time":"2025-02-03T12:54:29.255872","exception":false,"start_time":"2025-02-03T12:54:29.218794","status":"completed"},"tags":[]}},{"id":"5f7b410c","cell_type":"code","source":"import os\nimport numpy as np\nimport nibabel as nib\n\ndef load_3d_volumes(patient_id, dataset_dir):\n    \"\"\"\n    Load 4 modalities (Flair, T1, T1CE, T2) as separate 3D volumes (H,W,D).\n    Returns a dict of {modality: np.array}.\n    \"\"\"\n    modalities = ['flair', 't1', 't1ce', 't2']\n    patient_path = os.path.join(dataset_dir, patient_id)\n    volumes_3d   = {}\n    for mod in modalities:\n        filepath = os.path.join(patient_path, f\"{patient_id}_{mod}.nii\")\n        vol_3d   = nib.load(filepath).get_fdata(dtype=np.float32)\n        volumes_3d[mod] = vol_3d\n    return volumes_3d\n\ndef zscore_normalize_3d(volume_3d, ignore_zero=True, epsilon=1e-8):\n    \"\"\"\n    Z-score normalization for an entire 3D volume.\n    If ignore_zero=True, compute mean/std only on nonzero voxels.\n    (val - mean) / (std + epsilon).\n    \"\"\"\n    vol_copy = volume_3d.copy()\n    if ignore_zero:\n        mask = (vol_copy != 0)\n        valid = vol_copy[mask]\n        if len(valid) > 1:\n            m = valid.mean()\n            s = valid.std()\n            if s > 1e-8:\n                vol_copy[mask] = (vol_copy[mask] - m) / (s + epsilon)\n    else:\n        m = vol_copy.mean()\n        s = vol_copy.std()\n        if s > 1e-8:\n            vol_copy = (vol_copy - m) / (s + epsilon)\n    return vol_copy\n\ndef plot_histograms_3d(before_images, after_images):\n    \"\"\"\n    Shows before vs. after histograms for each modality in the entire 3D volume.\n    'before_images' and 'after_images' are dicts of {modality: 3D volume}.\n    We flatten each volume to get all voxels, ignoring zeros if you like.\n    \"\"\"\n    modalities = ['flair', 't1', 't1ce', 't2']\n    fig, axes = plt.subplots(2, 4, figsize=(20, 10))\n\n    for i, mod in enumerate(modalities):\n        # 1) Before\n        raw_vol = before_images[mod]\n        nonzero_raw = raw_vol[raw_vol != 0]  # ignoring zeros in histogram\n        axes[0, i].hist(nonzero_raw, bins=50, color='blue', alpha=0.7)\n        axes[0, i].set_title(f\"Raw {mod.upper()} Histogram\")\n        axes[0, i].set_xlabel(\"Pixel Intensity\")\n        axes[0, i].set_ylabel(\"Frequency\")\n\n        # 2) After\n        norm_vol = after_images[mod]\n        nonzero_norm = norm_vol[norm_vol != 0]\n        axes[1, i].hist(nonzero_norm, bins=50, color='green', alpha=0.7)\n        axes[1, i].set_title(f\"Z-Score Normalized {mod.upper()}\")\n        axes[1, i].set_xlabel(\"Pixel Intensity\")\n        axes[1, i].set_ylabel(\"Frequency\")\n\n    plt.tight_layout()\n    plt.show()\n\n# -----------------------------\n# Example usage:\n# -----------------------------\n\n    \npatient_id = \"BraTS20_Training_001\"\n    \n# 1) Load entire 3D volumes for each modality\nraw_3d_images = load_3d_volumes(patient_id, TRAIN_DATASET_DIR)\n\n# 2) Z-score normalize each entire volume\nnormalized_3d_images = {}\nfor mod, vol3d in raw_3d_images.items():\n        norm_vol = zscore_normalize_3d(vol3d, ignore_zero=True)\n        normalized_3d_images[mod] = norm_vol\n\n# 3) Plot before vs. after histograms\nplot_histograms_3d(raw_3d_images, normalized_3d_images)\n\n # (Optional) You can also view a slice from before vs. after if you want:\nslice_idx = raw_3d_images[\"flair\"].shape[-1]//2\nraw_slice  = raw_3d_images[\"flair\"][..., slice_idx]\nnorm_slice = normalized_3d_images[\"flair\"][..., slice_idx]\n\nplt.figure(figsize=(10,5))\nplt.subplot(1,2,1)\nplt.imshow(raw_slice, cmap='gray')\nplt.title(\"Raw Flair (Center Slice)\")\nplt.axis('off')\n\nplt.subplot(1,2,2)\nplt.imshow(norm_slice, cmap='gray')\nplt.title(\"Normalized Flair (Center Slice)\")\nplt.axis('off')\n\nplt.tight_layout()\nplt.show()\n","metadata":{"_cell_guid":"b34df625-a3cf-4b98-a538-d196e6119c5c","_uuid":"4fac75b7-37f1-44db-b62e-9f5c4e27fb89","collapsed":false,"execution":{"iopub.status.busy":"2025-03-06T10:59:30.090686Z","iopub.execute_input":"2025-03-06T10:59:30.091028Z","iopub.status.idle":"2025-03-06T10:59:33.124026Z","shell.execute_reply.started":"2025-03-06T10:59:30.090990Z","shell.execute_reply":"2025-03-06T10:59:33.122997Z"},"jupyter":{"outputs_hidden":false},"papermill":{"duration":4.669401,"end_time":"2025-02-03T12:54:33.962288","exception":false,"start_time":"2025-02-03T12:54:29.292887","status":"completed"},"tags":[],"trusted":true},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 2000x1000 with 8 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1000x500 with 2 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":12},{"id":"896470ca","cell_type":"code","source":"from skimage.transform import resize\n\ndef crop_to_brain_2d_simpler(flair_2d, t1_2d, t1ce_2d, t2_2d,\n                             seg_2d,\n                             margin=5,\n                             out_size=(240,240),\n                             epsilon=1e-5):\n\n    combined = np.abs(flair_2d) + np.abs(t1_2d) + np.abs(t1ce_2d) + np.abs(t2_2d)\n    coords   = np.where(combined > epsilon)\n    if len(coords[0]) == 0:\n        # Fallback: resize the entire slice\n        return resize_entire_slice(flair_2d, t1_2d, t1ce_2d, t2_2d, seg_2d, out_size)\n\n    min_r, max_r = np.min(coords[0]), np.max(coords[0])\n    min_c, max_c = np.min(coords[1]), np.max(coords[1])\n\n    # 2) Apply margin\n    min_r = max(0, min_r - margin)\n    min_c = max(0, min_c - margin)\n    max_r = min(flair_2d.shape[0], max_r + margin)\n    max_c = min(flair_2d.shape[1], max_c + margin)\n\n    # 3) Crop\n    flair_crop = flair_2d[min_r:max_r, min_c:max_c]\n    t1_crop    = t1_2d[min_r:max_r,   min_c:max_c]\n    t1ce_crop  = t1ce_2d[min_r:max_r, min_c:max_c]\n    t2_crop    = t2_2d[min_r:max_r,   min_c:max_c]\n    seg_crop   = seg_2d[min_r:max_r,  min_c:max_c]\n\n    # 4) Resize (No normalization here!)\n    final_img = np.zeros((*out_size, 4), dtype=np.float32)\n    for i, ch_data in enumerate([flair_crop, t1_crop, t1ce_crop, t2_crop]):\n        final_img[..., i] = resize(ch_data, out_size, preserve_range=True)\n    \n    # Return the mask as label map (H,W) or transform to one-hot outside\n    final_mask = resize(seg_crop, out_size, preserve_range=True, order=0).astype(np.int32)\n\n    return final_img, final_mask\n\ndef resize_entire_slice(flair_2d, t1_2d, t1ce_2d, t2_2d, seg_2d, out_size):\n    \"\"\"\n    Fallback if no brain region is detected: just resize the entire 2D plane.\n    \"\"\"\n    final_img = np.zeros((*out_size, 4), dtype=np.float32)\n    for i, ch_data in enumerate([flair_2d, t1_2d, t1ce_2d, t2_2d]):\n        final_img[..., i] = resize(ch_data, out_size, preserve_range=True)\n\n    final_mask = resize(seg_2d, out_size, preserve_range=True, order=0).astype(np.int32)\n    return final_img, final_mask\n","metadata":{"_cell_guid":"18be31a1-79f1-4690-a498-1899291551d1","_uuid":"c59d5bc9-87e9-4759-9ed0-a355307d76f3","collapsed":false,"execution":{"iopub.status.busy":"2025-03-06T10:59:33.125120Z","iopub.execute_input":"2025-03-06T10:59:33.125475Z","iopub.status.idle":"2025-03-06T10:59:33.134033Z","shell.execute_reply.started":"2025-03-06T10:59:33.125442Z","shell.execute_reply":"2025-03-06T10:59:33.133177Z"},"jupyter":{"outputs_hidden":false},"papermill":{"duration":0.05156,"end_time":"2025-02-03T12:54:34.053515","exception":false,"start_time":"2025-02-03T12:54:34.001955","status":"completed"},"tags":[],"trusted":true},"outputs":[],"execution_count":13},{"id":"f6b6c220","cell_type":"markdown","source":"# 4) Preprocess a Single Patient\n\n##### Loading MRI data\n\n* For the given patient_id, we load the 3D volumes: Flair, T1, T1CE, T2, and the segmentation (seg_data).\n* nib.load(...) reads the .nii file and get_fdata() gets it as a NumPy array.\n\n##### Convert label 4 → 3\n\n* In BraTS data, sometimes “enhancing tumor” label is 4. We remap label 4 to 3 to have 0,1,2,3 classes.\n\n##### Prepare Output Directories\n\n* Creates images_dir and masks_dir inside save_dir.\n\n##### Iterate over Slices\n* For each z in the 3D volume depth:\n    * Extract 2D slice for each modality.\n    * Call crop_to_brain_with_mask(...) to get the processed (final_img, final_mask).\n    * Convert final_mask to one-hot encoding: mask_1hot = np.eye(4)[final_mask.reshape(-1)].reshape(H, W, 4).\n* Compute Tumor Coverage:\n    * tumor_px = number of non-zero pixels in label_2d.\n    * coverage = tumor_px / total_pixels.\n* Based on coverage:\n    * If coverage >= big_tumor_thresh, it goes to big_slices.\n    * If coverage > 0 but < big_tumor_thresh, it goes to small_slices.\n    * If coverage == 0, it’s a “no tumor” slice (kept separately and we only keep up to 5 of these per patient).\n\n##### Save .npy Files\n\n* For each slice that we keep, we write out:\n    * The image data: np.save(...) with shape (240,240,4).\n    * The mask data: np.save(...) with shape (240,240,4) for one-hot.\n  \n##### Return: (big_slices, small_slices) lists of filenames.","metadata":{"_cell_guid":"fd1d1ace-68e3-4ec3-bd13-afe9e3f2e028","_uuid":"fa72cc6e-f376-48d8-a038-dbf271a8c4fa","collapsed":false,"jupyter":{"outputs_hidden":false},"papermill":{"duration":0.037389,"end_time":"2025-02-03T12:54:34.130038","exception":false,"start_time":"2025-02-03T12:54:34.092649","status":"completed"},"tags":[]}},{"id":"f8c29dce","cell_type":"code","source":"def preprocess_patient(\n    patient_id,\n    dataset_dir,\n    save_dir,\n    margin=15,\n    out_size=(240,240),\n    big_tumor_thresh=0.025\n):\n    \"\"\"\n    1) Load entire 3D volumes (Flair, T1, T1CE, T2, seg).\n    2) Normalize each volume in 3D ignoring zeros.\n    3) For each slice z in [0..depth-1]:\n         -> Extract 2D slice\n         -> Crop + resize (no re-normalize)\n         -> coverage check\n         -> Save\n    Returns (big_slices, small_slices).\n    \"\"\"\n\n    # 1) Load volumes\n    volumes_3d = load_3d_volumes(patient_id, dataset_dir)\n    flair_3d = volumes_3d[\"flair\"]\n    t1_3d    = volumes_3d[\"t1\"]\n    t1ce_3d  = volumes_3d[\"t1ce\"]\n    t2_3d    = volumes_3d[\"t2\"]\n\n    seg_path = os.path.join(dataset_dir, patient_id, f\"{patient_id}_seg.nii\")\n    seg_3d   = nib.load(seg_path).get_fdata(dtype=np.float32)\n    seg_3d[seg_3d == 4] = 3  # label 4 -> 3\n\n    # 2) Full-volume normalization (z-score ignoring zeros)\n    flair_3d = zscore_normalize_3d(flair_3d, ignore_zero=True)\n    t1_3d    = zscore_normalize_3d(t1_3d,    ignore_zero=True)\n    t1ce_3d  = zscore_normalize_3d(t1ce_3d,  ignore_zero=True)\n    t2_3d    = zscore_normalize_3d(t2_3d,    ignore_zero=True)\n\n    # Prepare output folders\n    images_dir = os.path.join(save_dir, \"images\")\n    masks_dir  = os.path.join(save_dir, \"masks\")\n    os.makedirs(images_dir, exist_ok=True)\n    os.makedirs(masks_dir,  exist_ok=True)\n\n    big_slices   = []\n    small_slices = []\n    no_tumor_temp= []\n\n    depth = flair_3d.shape[-1]\n\n    # 3) Slice by slice\n    for z in range(depth):\n        flair_2d  = flair_3d[..., z]\n        t1_2d     = t1_3d   [..., z]\n        t1ce_2d   = t1ce_3d [..., z]\n        t2_2d     = t2_3d   [..., z]\n        seg_2d    = seg_3d  [..., z].astype(np.int32)\n\n        # Crop (no re-normalization)\n        final_img, final_mask = crop_to_brain_2d_simpler(\n            flair_2d, t1_2d, t1ce_2d, t2_2d,\n            seg_2d,\n            margin=margin,\n            out_size=out_size\n        )\n\n        # One-hot encode the mask\n        H, W = final_mask.shape\n        mask_1hot = np.eye(4)[final_mask.reshape(-1)].reshape(H, W, 4)\n\n        # coverage check\n        label_2d = np.argmax(mask_1hot, axis=-1)\n        tumor_px = np.count_nonzero(label_2d>0)\n        coverage = tumor_px / label_2d.size\n\n        slice_fname = f\"{patient_id}_slice{z}.npy\"\n\n        if coverage == 0:\n            # no tumor => store temporarily\n            no_tumor_temp.append((slice_fname, final_img, mask_1hot))\n        else:\n            # coverage-based split\n            if coverage >= big_tumor_thresh:\n                big_slices.append(slice_fname)\n            else:\n                small_slices.append(slice_fname)\n\n            # save\n            np.save(os.path.join(images_dir, slice_fname), final_img.astype(np.float32))\n            np.save(os.path.join(masks_dir,  slice_fname), mask_1hot.astype(np.float32))\n\n    # Keep up to 3 no-tumor\n    import random\n    random.shuffle(no_tumor_temp)\n    no_tumor_temp = no_tumor_temp[:3]\n    for fname, im_data, mk_data in no_tumor_temp:\n        small_slices.append(fname)\n        np.save(os.path.join(images_dir, fname), im_data.astype(np.float32))\n        np.save(os.path.join(masks_dir, fname), mk_data.astype(np.float32))\n\n    return big_slices, small_slices\n","metadata":{"_cell_guid":"76e48e59-223f-4d17-8329-f44ee6cef12b","_uuid":"593aed60-5bb8-4f7e-98da-6461cac40c78","collapsed":false,"execution":{"iopub.status.busy":"2025-03-06T10:59:33.134855Z","iopub.execute_input":"2025-03-06T10:59:33.135162Z","iopub.status.idle":"2025-03-06T10:59:33.154993Z","shell.execute_reply.started":"2025-03-06T10:59:33.135140Z","shell.execute_reply":"2025-03-06T10:59:33.154282Z"},"jupyter":{"outputs_hidden":false},"papermill":{"duration":0.050646,"end_time":"2025-02-03T12:54:34.219035","exception":false,"start_time":"2025-02-03T12:54:34.168389","status":"completed"},"tags":[],"trusted":true},"outputs":[],"execution_count":14},{"id":"49b09fd8","cell_type":"code","source":"import os\nimport numpy as np\nimport nibabel as nib\nimport matplotlib.pyplot as plt\n\ndef compare_original_vs_preprocessed(\n    patient_id,\n    dataset_dir,\n    save_dir,\n    slice_index=100\n):\n    \"\"\"\n    1) Loads the ORIGINAL entire 3D volumes for the patient (Flair, T1, T1CE, T2, seg).\n    2) Loads the single preprocessed slice (images + masks) from 'save_dir'.\n    3) Displays:\n       - A 2x5 figure comparing original vs. preprocessed for this slice index.\n         Row 1: Original Flair, T1, T1CE, T2, seg\n         Row 2: Preprocessed Flair, T1, T1CE, T2, seg\n    4) Also plots a second figure with histograms of intensities for that single slice\n       to see distribution changes (ignoring zero).\n    \"\"\"\n\n    patient_path = os.path.join(dataset_dir, patient_id)\n    flair_original = nib.load(os.path.join(patient_path, f\"{patient_id}_flair.nii\")).get_fdata(dtype=np.float32)\n    t1_original    = nib.load(os.path.join(patient_path, f\"{patient_id}_t1.nii\")).get_fdata(dtype=np.float32)\n    t1ce_original  = nib.load(os.path.join(patient_path, f\"{patient_id}_t1ce.nii\")).get_fdata(dtype=np.float32)\n    t2_original    = nib.load(os.path.join(patient_path, f\"{patient_id}_t2.nii\")).get_fdata(dtype=np.float32)\n    seg_original   = nib.load(os.path.join(patient_path, f\"{patient_id}_seg.nii\")).get_fdata(dtype=np.float32)\n    seg_original[seg_original == 4] = 3  \n\n    # Check slice_index boundary\n    max_slices = flair_original.shape[-1]\n    if slice_index >= max_slices:\n        print(f\"slice_index={slice_index} is out of range, using middle slice instead.\")\n        slice_index = max_slices // 2\n\n    # Load preprocessed images\n    pre_img_path  = os.path.join(save_dir, \"images\", f\"{patient_id}_slice{slice_index}.npy\")\n    pre_mask_path = os.path.join(save_dir, \"masks\",  f\"{patient_id}_slice{slice_index}.npy\")\n    if not os.path.exists(pre_img_path) or not os.path.exists(pre_mask_path):\n        print(f\"Preprocessed slice {slice_index} not found for patient {patient_id}.\")\n        return\n\n    preprocessed_image = np.load(pre_img_path)        # shape (H, W, 4)\n    preprocessed_mask_1hot = np.load(pre_mask_path)   # shape (H, W, 4)\n    preprocessed_mask = np.argmax(preprocessed_mask_1hot, axis=-1)\n\n    # ---------------------------\n    # Figure 1: Original vs. Preprocessed (2x5 grid)\n    # ---------------------------\n    fig, axes = plt.subplots(2, 5, figsize=(20, 8))\n\n    # Original row\n    axes[0, 0].imshow(flair_original[..., slice_index], cmap=\"gray\")\n    axes[0, 0].set_title(\"Original Flair\")\n    axes[0, 0].axis(\"off\")\n\n    axes[0, 1].imshow(t1_original[..., slice_index], cmap=\"gray\")\n    axes[0, 1].set_title(\"Original T1\")\n    axes[0, 1].axis(\"off\")\n\n    axes[0, 2].imshow(t1ce_original[..., slice_index], cmap=\"gray\")\n    axes[0, 2].set_title(\"Original T1CE\")\n    axes[0, 2].axis(\"off\")\n\n    axes[0, 3].imshow(t2_original[..., slice_index], cmap=\"gray\")\n    axes[0, 3].set_title(\"Original T2\")\n    axes[0, 3].axis(\"off\")\n\n    axes[0, 4].imshow(seg_original[..., slice_index], cmap=\"jet\")\n    axes[0, 4].set_title(\"Original Mask\")\n    axes[0, 4].axis(\"off\")\n\n    # Preprocessed row\n    axes[1, 0].imshow(preprocessed_image[..., 0], cmap=\"gray\")\n    axes[1, 0].set_title(\"Pre Flair\")\n    axes[1, 0].axis(\"off\")\n\n    axes[1, 1].imshow(preprocessed_image[..., 1], cmap=\"gray\")\n    axes[1, 1].set_title(\"Pre T1\")\n    axes[1, 1].axis(\"off\")\n\n    axes[1, 2].imshow(preprocessed_image[..., 2], cmap=\"gray\")\n    axes[1, 2].set_title(\"Pre T1CE\")\n    axes[1, 2].axis(\"off\")\n\n    axes[1, 3].imshow(preprocessed_image[..., 3], cmap=\"gray\")\n    axes[1, 3].set_title(\"Pre T2\")\n    axes[1, 3].axis(\"off\")\n\n    axes[1, 4].imshow(preprocessed_mask, cmap=\"jet\")\n    axes[1, 4].set_title(\"Pre Mask\")\n    axes[1, 4].axis(\"off\")\n\n    fig.suptitle(f\"Original vs. Preprocessed - Patient {patient_id}, Slice {slice_index}\")\n    plt.tight_layout()\n    plt.show()\n\n    # ---------------------------\n    # Figure 2: Intensity Hist for the single slice (ignoring zero)\n    # ---------------------------\n    # We'll do a 2-row, 4-col layout: top row = original, bottom row = preprocessed\n    fig2, ax2 = plt.subplots(2, 4, figsize=(20, 8))\n    mod_names = [\"Flair\",\"T1\",\"T1CE\",\"T2\"]\n\n    # Original slice data\n    original_slices = [\n        flair_original[..., slice_index],\n        t1_original[..., slice_index],\n        t1ce_original[..., slice_index],\n        t2_original[..., slice_index]\n    ]\n    # Preprocessed slice data\n    pre_slices = [\n        preprocessed_image[...,0],\n        preprocessed_image[...,1],\n        preprocessed_image[...,2],\n        preprocessed_image[...,3]\n    ]\n\n    for i in range(4):\n        # Original slice ignoring zeros\n        orig_slice_1d = original_slices[i].flatten()\n        orig_nonzero  = orig_slice_1d[orig_slice_1d != 0]\n        ax2[0, i].hist(orig_nonzero, bins=50, alpha=0.7, color='blue')\n        ax2[0, i].set_title(f\"Original {mod_names[i]}\")\n        ax2[0, i].set_xlabel(\"Intensity\")\n        ax2[0, i].set_ylabel(\"Count\")\n        ax2[0, i].grid(True)\n\n        # Preprocessed ignoring zeros\n        pre_slice_1d = pre_slices[i].flatten()\n        pre_nonzero  = pre_slice_1d[pre_slice_1d != 0]\n        ax2[1, i].hist(pre_nonzero, bins=50, alpha=0.7, color='green')\n        ax2[1, i].set_title(f\"Preprocessed {mod_names[i]}\")\n        ax2[1, i].set_xlabel(\"Intensity\")\n        ax2[1, i].set_ylabel(\"Count\")\n        ax2[1, i].grid(True)\n\n    plt.tight_layout()\n    plt.show()\n","metadata":{"_cell_guid":"cff2d120-0ae1-4ffc-bd85-8af5412e7964","_uuid":"a7910083-18de-4e0f-9084-9bc010135933","collapsed":false,"execution":{"iopub.status.busy":"2025-03-06T10:59:33.155794Z","iopub.execute_input":"2025-03-06T10:59:33.156042Z","iopub.status.idle":"2025-03-06T10:59:33.173258Z","shell.execute_reply.started":"2025-03-06T10:59:33.156012Z","shell.execute_reply":"2025-03-06T10:59:33.172457Z"},"jupyter":{"outputs_hidden":false},"papermill":{"duration":3.421358,"end_time":"2025-02-03T12:54:37.680317","exception":false,"start_time":"2025-02-03T12:54:34.258959","status":"completed"},"tags":[],"truste